# Copy to backend/.env to override. Everything here is optional:
# the backend auto-detects ComfyUI Desktop and llama.cpp on this machine.

# Backend HTTP port (the frontend talks to this)
PORT=4000
# Comma-separated origins allowed to call the API
FRONTEND_ORIGIN=http://localhost:3000

# 'auto'   = unload one engine from the GPU before the other one needs it (8 GB cards)
# 'manual' = never unload automatically
GPU_MODE=auto

# ---------- Image generation (ComfyUI) ----------
# auto   = reuse ComfyUI at COMFY_URL if it's running (e.g. ComfyUI Desktop), else launch it headless
# attach = only use COMFY_URL, never launch anything
# spawn  = always launch our own headless engine on ENGINE_PORT
ENGINE_MODE=auto
COMFY_URL=http://127.0.0.1:8188
ENGINE_PORT=8190
# COMFY_DIR=C:\Users\<you>\AppData\Local\Comfy-Desktop\ComfyUI-Installs\ComfyUI\ComfyUI
# COMFY_PYTHON=C:\Users\<you>\AppData\Local\Comfy-Desktop\ComfyUI-Installs\ComfyUI\ComfyUI\.venv\Scripts\python.exe
# COMFY_EXTRA_MODEL_PATHS=C:\path\to\extra_model_paths.yaml
# COMFY_OUTPUT_DIR=C:\path\to\output
# COMFY_INPUT_DIR=C:\path\to\input
# Extra flags passed to ComfyUI's main.py, e.g. "--lowvram"
ENGINE_EXTRA_ARGS=--disable-all-custom-nodes
# Images are saved to <ComfyUI output>/<OUTPUT_PREFIX>_00001_.png
OUTPUT_PREFIX=Interface/sdxl

# ---------- Chat (llama.cpp) ----------
# Defaults to the newest llama-*/llama-server.exe next to the Interface folder
# LLAMA_SERVER=D:\llama-inference\llama-b11699-bin-win-cuda-13.4-x64\llama-server.exe
# Folder with .gguf models (default: D:\llama-inference\models)
# LLM_MODELS_DIR=D:\llama-inference\models
LLM_PORT=8080
# First-run defaults; afterwards the Chat page's settings are used (saved in data/settings.json)
# LLM_MODEL=Qwen_Qwen3.5-9B-Q4_K_M.gguf
LLM_CTX=65536
# auto (fit to free VRAM), all, or a number of layers
LLM_GPU_LAYERS=auto
# Extra flags for llama-server
LLM_EXTRA_ARGS=-fa on --cache-type-k q8_0 --cache-type-v q8_0
