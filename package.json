{
  "name": "comfy-interface",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone SDXL image generator: Next.js frontend + Node.js backend driving a headless ComfyUI engine.",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -k -n backend,frontend -c cyan,magenta \"npm:dev -w backend\" \"npm:dev -w frontend\"",
    "build": "npm run build -w frontend",
    "start": "concurrently -k -n backend,frontend -c cyan,magenta \"npm:start -w backend\" \"npm:start -w frontend\""
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
